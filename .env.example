# Server-only integration variables are documented without values.
# Never use NEXT_PUBLIC_ for any variable listed here.

# Required for persistent workflow storage.
# DATABASE_URL=

# Optional object storage. If configured, provide all four values.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional pi-ai/OpenRouter model access. Models must be OpenRouter free routes.
# PI_AI_PROVIDER=openrouter
# PI_AI_MODEL=openrouter/free
# PI_AI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free

# Optional authorized OpenCLI Gateway. If configured, provide both values.
# OPENCLI_GATEWAY_URL=
# OPENCLI_GATEWAY_TOKEN=
# OPENCLI_TIMEOUT_MS=30000

# Deployment metadata and optional public origin.
# NODE_ENV=development
# VERCEL_ENV=preview
# VERCEL_REGION=
# APP_URL=

# Job execution defaults are safe for the foundation and can be overridden by deployment.
# JOB_RUNNER=sync
# JOB_QUEUE_URL=
# JOB_MAX_RETRIES=2
# JOB_TIMEOUT_MS=30000
# JOB_POLL_INTERVAL_MS=2000
